#version 330
#extension GL_ARB_separate_shader_objects : require

// =====================================================================================================================
// Facility main-menu monitor look + transitions (Minecraft 26.3 post effect).
//
// A post effect cannot read plugin state, so the plugin picks between pre-made variants: the post_effect/menu_*.json
// files, generated by tools/gen_menu_fx.py. They all run this one shader and differ only in the MenuConfig values
// below. An animation is a run of numbered variants (menu_green_out_01..12) that the plugin steps through, one per
// tick. Grain, tearing and flicker animate on their own from the engine's GameTime.
//
// The menu dialog blurs whatever is behind it (the player's "Menu Background Blurriness" setting), so the fine detail
// here - scanlines, grain - is only crisp while no dialog is open, i.e. during the transitions.
// =====================================================================================================================

// ---- screen texture -------------------------------------------------------------------------------------------------
const float SCAN_PERIOD_PX = 4.0;       // distance between scanlines, screen pixels
const float ROLL_STRENGTH = 0.06;       // brightness of the slow rolling bar
const float ROLL_SPEED = 0.07;          // rolling bar speed, screens per second
const float GRAIN_PX = 2.0;             // grain size, screen pixels
const float FLICKER_HZ = 10.0;          // brightness flicker steps per second
const float FLICKER_AMOUNT = 0.03;      // flicker depth at full grade. Keep it low: this runs for minutes.
const float VIGNETTE_INNER = 0.40;      // vignette starts here (0 = screen centre, 1 = corner)
const float VIGNETTE_OUTER = 1.05;      // fully dark here

// ---- glitch (MenuConfig.Glitch scales all of it) --------------------------------------------------------------------
const float TEAR_BANDS = 14.0;          // horizontal bands the picture is split into for tearing
const float TEAR_RATE = 14.0;           // how often tearing re-rolls, per second
const float TEAR_CHANCE = 0.45;         // chance per band and roll to tear
const float TEAR_SHIFT = 0.07;          // max sideways shift of a torn band, UV units
const float GLITCH_CHROMA = 0.012;      // extra chromatic aberration, UV units
const float GLITCH_NOISE = 0.30;        // extra grain

// ---- power-off collapse (MenuConfig.Collapse 0..1) ------------------------------------------------------------------
const float COLLAPSE_SPLIT = 0.6;       // 0..SPLIT squeezes the picture to a line, SPLIT..1 shrinks the line to a dot
const float COLLAPSE_LINE = 0.006;      // height of the line, fraction of the screen
const float COLLAPSE_GLOW = 2.5;        // how much brighter the squeezed picture burns

uniform sampler2D InSampler;

layout(std140) uniform SamplerInfo {
    vec2 OutSize;
    vec2 InSize;
};

// Same block and layout as minecraft:globals.glsl (26.3).
layout(std140) uniform Globals {
    ivec3 CameraBlockPos;
    float GlintAlpha;
    vec3 CameraOffset;
    float GameTime;
    vec2 ScreenSize;
    int MenuBlurRadius;
    int UseRgss;
};

// Order and types must match the "MenuConfig" list in the post_effect JSON (tools/gen_menu_fx.py).
layout(std140) uniform MenuConfig {
    vec4 Tint;          // rgb = phosphor colour, a = how much of the picture is graded to it (0 = untouched)
    float Gain;         // brightness of the graded picture
    float Noise;        // grain amount
    float Scan;         // scanline depth, 0 = none
    float Aberration;   // chromatic aberration, UV units
    float Vignette;     // corner darkening, 0 = none
    float Glitch;       // 0..1 tearing / static burst
    float Collapse;     // 0..1 CRT power-off
    float Fade;         // 0..1 fade to black
};

layout(location = 0) in vec2 texCoord;

layout(location = 0) out vec4 fragColor;

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

void main() {
    float t = GameTime * 1200.0;   // seconds
    vec2 px = texCoord * OutSize;
    vec2 uv = texCoord;
    float lit = 1.0;

    if (Collapse > 0.0) {
        float sy = mix(1.0, COLLAPSE_LINE, smoothstep(0.0, COLLAPSE_SPLIT, Collapse));
        float sx = 1.0 - smoothstep(COLLAPSE_SPLIT, 1.0, Collapse);
        vec2 src = (texCoord - 0.5) / vec2(max(sx, 0.0001), sy);
        lit = step(abs(src.x), 0.5) * step(abs(src.y), 0.5) * (1.0 + COLLAPSE_GLOW * Collapse);
        uv = src + 0.5;
    }

    if (Glitch > 0.0) {
        float roll = floor(t * TEAR_RATE);
        float band = floor((uv.y + hash12(vec2(roll, 3.0))) * TEAR_BANDS);
        float tear = step(1.0 - TEAR_CHANCE * Glitch, hash12(vec2(band, roll)));
        uv.x += (hash12(vec2(band, roll + 1.0)) - 0.5) * 2.0 * TEAR_SHIFT * Glitch * tear;
    }

    uv = clamp(uv, 0.0, 1.0);
    vec2 split = vec2(Aberration + GLITCH_CHROMA * Glitch, 0.0) * (0.5 + length(texCoord - 0.5));
    vec3 col = vec3(texture(InSampler, clamp(uv + split, 0.0, 1.0)).r,
                    texture(InSampler, uv).g,
                    texture(InSampler, clamp(uv - split, 0.0, 1.0)).b);

    float luma = dot(col, vec3(0.299, 0.587, 0.114));
    col = mix(col, Tint.rgb * luma * Gain, Tint.a);

    col *= 1.0 - Scan * (0.5 + 0.5 * cos(px.y * 6.2831853 / SCAN_PERIOD_PX));
    col *= 1.0 + ROLL_STRENGTH * Scan * smoothstep(0.12, 0.0, abs(texCoord.y - fract(t * ROLL_SPEED)));
    col += (hash12(floor(px / GRAIN_PX) + fract(t * 37.0) * vec2(131.0, 71.0)) - 0.5)
        * (Noise + GLITCH_NOISE * Glitch);
    col *= 1.0 - FLICKER_AMOUNT * Tint.a * hash12(vec2(floor(t * FLICKER_HZ), 5.0));
    col *= 1.0 - Vignette * smoothstep(VIGNETTE_INNER, VIGNETTE_OUTER, length(texCoord - 0.5) * 1.41421);

    fragColor = vec4(max(col, 0.0) * lit * (1.0 - Fade), 1.0);
}
